CCEffect %{
  techniques:
  - passes:
    - vert: camp-vs:vert
      frag: camp-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      rasterizerState: { cullMode: none }
      properties:
        lightMask: { value: black }
        fireMotion: { value: [0, 0, 0, 0] }
        stationLight: { value: [0, 0, 0, 0] }
}%

CCProgram camp-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 uv;
  vec4 vert () {
    uv = a_texCoord;
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    return cc_matViewProj * pos;
  }
}%

CCProgram camp-fs %{
  precision highp float;
  in vec2 uv;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform sampler2D lightMask;
  uniform Camp {
    vec4 fireMotion;    // seconds, motion enabled, reflected firelight, gate focus
    vec4 stationLight;  // keeper, bench, warehouse, brazier
  };
  const vec2 plate = vec2(1440.0, 900.0);
  float pool(vec2 p, vec2 center, vec2 radii) {
    vec2 d = (p - center) / radii;
    return 1.0 - smoothstep(0.0, 1.0, dot(d, d));
  }
  float flamePigment(vec3 rgb) {
    return smoothstep(0.14, 0.37, rgb.r - rgb.b);
  }
  vec4 frag () {
    vec2 p = uv * plate;
    vec3 paint = texture(cc_spriteTexture, uv).rgb;
    float gate = pool(p, vec2(777.0, 450.0), vec2(29.0, 179.0));
    paint += vec3(0.12, 0.075, 0.029) * gate * fireMotion.w;
    if (p.y < 466.0 || p.y > 817.0) return vec4(paint, 1.0);
    float t = fireMotion.x;
    float pulse = fireMotion.z;
    if (p.x > 560.0 && p.x < 730.0 && p.y > 490.0 && p.y < 640.0) {
      // Only the upper brushstrokes lean. The painted coal bed stays on the rim.
      float h = clamp((640.0 - p.y) / 102.0, 0.0, 1.0);
      float side = (p.x - 645.0) / 48.0;
      vec2 bend = vec2(2.6 * sin(1.45*t - 2.1*h) + 0.9 * sin(2.35*t - 3.3*h + side),
                       1.3 * sin(1.75*t + 1.4*side) + 0.6 * sin(2.65*t - 2.0*h));
      float sway = h * h * smoothstep(505.0, 535.0, p.y) * fireMotion.y;
      vec3 moved = texture(cc_spriteTexture, uv + bend * sway / plate).rgb;
      paint = mix(paint, moved, max(flamePigment(paint), flamePigment(moved)));
      paint += vec3(0.014, 0.010, 0.004) * pulse * flamePigment(paint);
    }
    // Most of the amber on the stones comes from the steady coal bed.
    float bounce = pool(p, vec2(647.0, 765.0), vec2(186.0, 49.0)) +
                   0.65 * pool(p, vec2(649.0, 686.0), vec2(83.0, 63.0));
    paint += vec3(0.026, 0.014, 0.005) * bounce * (1.0 + 0.18 * pulse);
    float focus = p.x < 455.0 ? stationLight.y : (p.x < 770.0 ? stationLight.w :
                  (p.x < 1015.0 ? stationLight.x : stationLight.z));
    float mask = texture(lightMask, uv).r;
    // Grazing light follows the original silhouette and the painted highlights.
    float edge = max(0.0, mask - texture(lightMask, uv - vec2(2.0, 2.5) / plate).r);
    float value = dot(paint, vec3(0.30, 0.59, 0.11));
    float catchLight = mask * (0.32 + 1.10 * value) + 0.68 * edge;
    paint += vec3(1.0, 0.72, 0.41) * catchLight * (0.10 + 0.25 * focus);
    // Light cast by the bench lamp, keeper's lantern and the store tent.
    float lamps = pool(p, vec2(231.0, 557.0), vec2(181.0, 68.0)) * (0.053 + 0.08 * stationLight.y) +
                  pool(p, vec2(844.0, 545.0), vec2(70.0, 64.0)) * (0.095 + 0.11 * stationLight.x) +
                  pool(p, vec2(1216.0, 600.0), vec2(151.0, 91.0)) * (0.064 + 0.084 * stationLight.z);
    lamps += pool(p, vec2(527.0, 701.0), vec2(64.0, 36.0)) * 0.085 * stationLight.w;
    paint += vec3(1.0, 0.64, 0.26) * lamps;
    float fittings = pool(p, vec2(153.0, 538.0), vec2(60.0, 33.0)) +
                     pool(p, vec2(838.0, 545.0), vec2(16.0, 15.0)) +
                     pool(p, vec2(1151.0, 604.0), vec2(49.0, 30.0)) +
                     pool(p, vec2(1278.0, 630.0), vec2(44.0, 21.0));
    float glint = smoothstep(0.75, 1.0, sin(t * 0.68 - p.x * 0.023 + p.y * 0.016));
    paint += vec3(0.070, 0.048, 0.024) * mask * fittings * glint * fireMotion.y;
    return vec4(paint, 1.0);
  }
}%

CCEffect %{
  techniques:
  - passes:
    - vert: survivor-toon-vs:vert
      frag: survivor-toon-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: true }
      properties:
        mainTexture: { value: white }
  - name: ground-contact
    passes:
    - vert: survivor-shadow-vs:vert
      frag: survivor-shadow-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState:
        targets:
        - { blend: true, blendSrc: src_alpha, blendDst: one_minus_src_alpha }
  - name: model-studio
    passes:
    - vert: survivor-shadow-vs:vert
      frag: survivor-studio-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
  - name: clay-model
    passes:
    - vert: survivor-toon-vs:vert
      frag: survivor-clay-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: true }
}%

CCProgram survivor-toon-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/input-standard>
  #include <legacy/local-batch>
  out vec2 uv;
  out vec3 worldNormal;
  out vec3 towardEye;
  out float ambient;
  #if USE_BAKED_AO
    in vec4 a_color;
  #endif
  vec4 vert () {
    StandardVertInput source;
    CCVertInput(source);
    mat4 world, worldIT;
    CCGetWorldMatrixFull(world, worldIT);
    uv = a_texCoord;
    worldNormal = normalize(mat3(worldIT) * source.normal);
    towardEye = cc_cameraPos.xyz - (world * source.position).xyz;
    #if USE_BAKED_AO
      ambient = a_color.r;
    #else
      ambient = 1.0;
    #endif
    return cc_matViewProj * world * source.position;
  }
}%

CCProgram survivor-shadow-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/input>
  #include <legacy/local-batch>
  out vec2 uv;
  vec4 vert () {
    vec4 p; CCVertInput(p); mat4 world; CCGetWorldMatrix(world);
    uv = a_texCoord;
    return cc_matViewProj * world * p;
  }
}%
CCProgram survivor-shadow-fs %{
  precision highp float;
  in vec2 uv;
  vec4 frag () {
    float r = length((uv - 0.5) * 2.0);
    return vec4(0.13, 0.10, 0.16, 0.39 * (1.0 - smoothstep(0.10,1.0,r)));
  }
}%

CCProgram survivor-studio-fs %{
  precision highp float;
  in vec2 uv;
  vec4 frag () {
    float halo=1.0-smoothstep(.04,.87,length((uv-vec2(.44,.60))*vec2(1.10,.84)));
    return vec4(mix(vec3(.36,.325,.378),vec3(.66,.607,.627),halo),1.0);
  }
}%

CCProgram survivor-toon-fs %{
  precision highp float;
  in vec2 uv;
  in vec3 worldNormal;
  in vec3 towardEye;
  in float ambient;
  uniform sampler2D mainTexture;
  vec4 frag () {
    vec3 base = texture(mainTexture, uv).rgb;
    vec3 n = normalize(worldNormal);
    float key = dot(n, normalize(vec3(-0.42, 0.64, 0.74)));
    float soft = smoothstep(-0.32, 0.04, key);
    float light = smoothstep(0.30, 0.57, key);
    vec3 ink = mix(vec3(0.74,0.76,0.84), vec3(0.95,0.94,0.97), soft);
    ink = mix(ink, vec3(1.09,1.055,1.025), light);
    float rim = pow(1.0-clamp(dot(n,normalize(towardEye)),0.,1.),3.0);
    vec3 painted = base * ink * mix(1.0,ambient,.76) + vec3(.025,.023,.027)*rim*light;
    return vec4(painted,1.0);
  }
}%

CCProgram survivor-clay-fs %{
  precision highp float;
  in vec3 worldNormal;
  in vec3 towardEye;
  in float ambient;
  vec4 frag () {
    vec3 n=normalize(worldNormal);
    float key=dot(n,normalize(vec3(-.42,.64,.74)));
    float rim=pow(1.0-clamp(dot(n,normalize(towardEye)),0.,1.),3.0);
    vec3 neutral=vec3(.75,.69,.68)*(.43+.57*smoothstep(-.75,.88,key))*(.82+.18*smoothstep(-.29,.06,key))*max(.68,ambient)+rim*.045;
    return vec4(neutral,1.0);
  }
}%
